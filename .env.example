SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ADMIN_EMAIL=admin@cooperativa.com
ADMIN_PASSWORD=CambiaEsta123
# Origenes del frontend permitidos (separados por coma). Con cookies de sesión se listan uno a uno.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=sqlite:///./cooperativa.db
# Duración de la sesión (y de la cookie) en minutos
TOKEN_MINUTES=480
# "production" marca la cookie de sesión como Secure (solo viaja por HTTPS)
ENVIRONMENT=development

# PostgreSQL (usuario, clave, puerto y base). Ejemplo para este equipo, que usa el puerto 5433:
# DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5433/cooperativa
