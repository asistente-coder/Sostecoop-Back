SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ADMIN_EMAIL=admin.sostecoop@gmail.com
ADMIN_PASSWORD=sostecoopltda
# Origenes del frontend permitidos (separados por coma). Con cookies de sesión se listan uno a uno.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Duración de la sesión (y de la cookie) en minutos
TOKEN_MINUTES=480
# "production" marca la cookie de sesión como Secure (solo viaja por HTTPS)
ENVIRONMENT=development

# Base de datos: PostgreSQL (usuario, clave, puerto y base). Crear antes la base: CREATE DATABASE cooperativa;
# Si la clave tiene símbolos como @ o #, codificarlos (@ -> %40).
DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/cooperativa

# Solo para pruebas rápidas, sin PostgreSQL:
# DATABASE_URL=sqlite:///./cooperativa.db

# Opcional: fecha de creación (ISO 8601) para las noticias antiguas que no la tienen. Vacío = el momento de la migración
# NEWS_CREATED_AT_FALLBACK=2026-10-01T00:00:00+00:00
